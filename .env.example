# dynmod environment template — copy to .env and fill in.
# .env is gitignored; never commit real credentials.

# --- Database (Postgres on Railway) ---------------------------------
# Either DYNMOD_DATABASE_URL on its own, or the discrete vars below.
DYNMOD_DATABASE_URL=postgres://user:password@host:5432/dynmod

DYNMOD_PGHOST=localhost
DYNMOD_PGPORT=5432
DYNMOD_PGDATABASE=dynmod
DYNMOD_PGUSER=dynmod
DYNMOD_PGPASSWORD=changeme

# --- API (Phase 7) --------------------------------------------------
DYNMOD_API_PORT=8787
DYNMOD_API_HOST=0.0.0.0
DYNMOD_API_CORS_ORIGIN=http://localhost:5173

# --- Frontend (Phase 8) ---------------------------------------------
VITE_DYNMOD_API_URL=http://localhost:8787

# --- Sleeper (Phase 1c, ADP ingest) ---------------------------------
# Sleeper's public endpoints don't require auth, but we cache locally.
DYNMOD_SLEEPER_CACHE_DIR=./r-pipeline/cache/sleeper

# --- Logging --------------------------------------------------------
DYNMOD_LOG_LEVEL=INFO
DYNMOD_LOG_DIR=./r-pipeline/logs
